  <url>
    <loc>https://packingcoffee.netlify.app/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://packingcoffee.netlify.app/products.html</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
